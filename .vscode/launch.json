            "console": "integratedTerminal"
        },
        {
            "name": "Launch Kessler AI (Survival Mode)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": ["--mode", "survival"],
            "console": "integratedTerminal"
        },
        {
